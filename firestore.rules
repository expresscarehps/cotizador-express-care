rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad ───────────────────────────────────────────────
    function logueado() {
      return request.auth != null && request.auth.token.email != null;
    }
    function correo() {
      return request.auth.token.email.lower();
    }
    // Superadministrador: fijo aquí para que nunca te quedes fuera
    function esSuper() {
      return logueado()
        && request.auth.token.email_verified == true
        && correo() == 'carlos.mtz@expresscarecuu.com';
    }
    // Usuarios dados de alta en la colección "usuarios" (el ID del documento es el correo en minúsculas)
    function perfilDoc() {
      return get(/databases/$(database)/documents/usuarios/$(correo()));
    }
    function activo() {
      return logueado()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/usuarios/$(correo()))
        && perfilDoc().data.activo == true;
    }
    function esAdmin() {
      return esSuper() || (activo() && perfilDoc().data.rol == 'administrador');
    }
    function esCotizador() {
      return esSuper() || activo();
    }

    // ── Colecciones del cotizador ───────────────────────────────
    match /cotizaciones/{id} {
      allow read, create, update: if esCotizador();
      allow delete: if false;
    }
    match /folios/{id} {
      allow read, write: if esCotizador();
    }
    match /tarifas/{id} {
      allow read: if esCotizador();
      allow write: if esAdmin();
    }
    // Listas de proveedores por servicio ("listas" real, "listas_prueba" para dev).
    // Las asesoras pueden AGREGAR proveedores (no quitar ni renombrar); solo un administrador reemplaza las listas.
    function conservaLista(k) {
      return request.resource.data.listas[k].hasAll(resource.data.listas[k]);
    }
    function listaValida(k) {
      return request.resource.data.listas[k] is list && request.resource.data.listas[k].size() <= 60;
    }
    function listasValidas() {
      return request.resource.data.listas is map
        && listaValida('afinacion') && listaValida('aceite') && listaValida('frenos')
        && listaValida('suspension') && listaValida('libre') && listaValida('rectificado');
    }
    match /proveedores/{id} {
      allow read: if esCotizador();
      allow create: if esCotizador() && id in ['listas', 'listas_prueba'] && listasValidas();
      allow update: if esCotizador() && id in ['listas', 'listas_prueba'] && listasValidas()
        && (esAdmin()
            || (conservaLista('afinacion') && conservaLista('aceite') && conservaLista('frenos')
                && conservaLista('suspension') && conservaLista('libre') && conservaLista('rectificado')));
      allow delete: if false;
    }

    // ── Usuarios y roles ────────────────────────────────────────
    // Superadministrador: administra a todos. Administrador: solo da de alta/baja
    // a usuarios con rol "usuario". El superadministrador no se puede tocar.
    match /usuarios/{id} {
      allow get: if logueado() && (esAdmin() || correo() == id);
      allow list: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.correo == id
        && id == id.lower()
        && id != 'carlos.mtz@expresscarecuu.com'
        && (esSuper()
              ? request.resource.data.rol in ['administrador', 'usuario']
              : request.resource.data.rol == 'usuario');
      allow update: if esAdmin()
        && request.resource.data.correo == id
        && (esSuper()
              ? request.resource.data.rol in ['administrador', 'usuario']
              : (resource.data.rol == 'usuario' && request.resource.data.rol == 'usuario'));
      allow delete: if esSuper();
    }

    // Todo lo demás (catalogo_llantas, conversaciones_bot, etc.) queda cerrado al navegador
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
